{
  // Cloudflare Workers Static Assets — serves the built React mini-app (SPA).
  // Build: pnpm --filter @brewdial/miniapp vite:build  → apps/miniapp/dist
  // Deploy: npx wrangler deploy
  "name": "brewdial",
  "compatibility_date": "2026-06-22",
  "assets": {
    "directory": "./apps/miniapp/dist",
    "not_found_handling": "single-page-application"
  }
}
