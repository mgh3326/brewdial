{
  "description": "Validation parity cases. Inputs are hand-written; every `expected` is generated from packages/shared/src/validation.ts by `pnpm --filter @brewdial/shared parity:update`. The Kotlin validators in apps/api-kt must produce the same values (ParityGoldenTest). `validator` names the shared function without the `validate` prefix and `Input` suffix.",
  "cases": [
    {
      "name": "recipe: minimal, unknown fields dropped",
      "validator": "CreateRecipe",
      "input": {
        "method": "v60",
        "title": "Test V60",
        "bogus": "drop"
      },
      "expected": {
        "ok": true,
        "value": {
          "method": "v60",
          "title": "Test V60"
        },
        "warnings": []
      }
    },
    {
      "name": "recipe: title is trimmed",
      "validator": "CreateRecipe",
      "input": {
        "method": "v60",
        "title": "  Morning  "
      },
      "expected": {
        "ok": true,
        "value": {
          "method": "v60",
          "title": "Morning"
        },
        "warnings": []
      }
    },
    {
      "name": "recipe: notes keep their whitespace (#602)",
      "validator": "CreateRecipe",
      "input": {
        "method": "v60",
        "title": "X",
        "notes": "  line one\n  line two\n\n[xbloom]  "
      },
      "expected": {
        "ok": true,
        "value": {
          "method": "v60",
          "title": "X",
          "notes": "  line one\n  line two\n\n[xbloom]  "
        },
        "warnings": []
      }
    },
    {
      "name": "recipe: adjustmentFromPrevious is trimmed",
      "validator": "CreateRecipe",
      "input": {
        "method": "v60",
        "title": "X",
        "adjustmentFromPrevious": "  finer  "
      },
      "expected": {
        "ok": true,
        "value": {
          "method": "v60",
          "title": "X",
          "adjustmentFromPrevious": "finer"
        },
        "warnings": []
      }
    },
    {
      "name": "recipe: full input",
      "validator": "CreateRecipe",
      "input": {
        "method": "espresso",
        "title": "Morning shot",
        "params": {
          "doseG": 18,
          "waterG": 36,
          "tempC": 93,
          "grinder": "K6",
          "brewer": "Gaggia"
        },
        "steps": [
          {
            "atSec": 0,
            "waterG": 0,
            "note": "Pre-infuse"
          }
        ],
        "intent": [
          "sweeter"
        ],
        "notes": "First",
        "adjustmentFromPrevious": "finer",
        "createdBy": "agent",
        "beanId": "bean:abc",
        "beanSnapshot": {
          "name": "Geisha",
          "roaster": "Tim"
        }
      },
      "expected": {
        "ok": true,
        "value": {
          "method": "espresso",
          "title": "Morning shot",
          "beanId": "bean:abc",
          "beanSnapshot": {
            "name": "Geisha",
            "roaster": "Tim"
          },
          "params": {
            "doseG": 18,
            "waterG": 36,
            "tempC": 93,
            "grinder": "K6",
            "brewer": "Gaggia"
          },
          "steps": [
            {
              "note": "Pre-infuse",
              "atSec": 0,
              "waterG": 0
            }
          ],
          "intent": [
            "sweeter"
          ],
          "notes": "First",
          "adjustmentFromPrevious": "finer",
          "createdBy": "agent"
        },
        "warnings": [
          "a timed step has no endSec; pour timing cannot be fully verified"
        ]
      }
    },
    {
      "name": "recipe: structured pour steps",
      "validator": "CreateRecipe",
      "input": {
        "method": "v60",
        "title": "X",
        "params": {
          "doseG": 15,
          "waterG": 250
        },
        "steps": [
          {
            "atSec": 0,
            "endSec": 35,
            "waterG": 60,
            "pourRateGPerSec": 1.7,
            "note": "Bloom"
          },
          {
            "atSec": 45,
            "endSec": 90,
            "waterG": 250,
            "note": "Main"
          }
        ]
      },
      "expected": {
        "ok": true,
        "value": {
          "method": "v60",
          "title": "X",
          "params": {
            "doseG": 15,
            "waterG": 250
          },
          "steps": [
            {
              "note": "Bloom",
              "atSec": 0,
              "waterG": 60,
              "endSec": 35,
              "pourRateGPerSec": 1.7
            },
            {
              "note": "Main",
              "atSec": 45,
              "waterG": 250,
              "endSec": 90
            }
          ]
        },
        "warnings": []
      }
    },
    {
      "name": "recipe: not an object",
      "validator": "CreateRecipe",
      "input": "nope",
      "expected": {
        "ok": false,
        "errors": [
          "input must be an object"
        ]
      }
    },
    {
      "name": "recipe: array body",
      "validator": "CreateRecipe",
      "input": [],
      "expected": {
        "ok": false,
        "errors": [
          "input must be an object"
        ]
      }
    },
    {
      "name": "recipe: missing title",
      "validator": "CreateRecipe",
      "input": {
        "method": "v60"
      },
      "expected": {
        "ok": false,
        "errors": [
          "title is required and must be a non-empty string"
        ]
      }
    },
    {
      "name": "recipe: blank title",
      "validator": "CreateRecipe",
      "input": {
        "method": "v60",
        "title": "   "
      },
      "expected": {
        "ok": false,
        "errors": [
          "title is required and must be a non-empty string"
        ]
      }
    },
    {
      "name": "recipe: invalid method",
      "validator": "CreateRecipe",
      "input": {
        "method": "french-press",
        "title": "X"
      },
      "expected": {
        "ok": false,
        "errors": [
          "method must be one of v60, espresso, aeropress, kalita, other"
        ]
      }
    },
    {
      "name": "recipe: non-string notes",
      "validator": "CreateRecipe",
      "input": {
        "method": "v60",
        "title": "X",
        "notes": 3
      },
      "expected": {
        "ok": false,
        "errors": [
          "input.notes must be a string"
        ]
      }
    },
    {
      "name": "recipe: step without note",
      "validator": "CreateRecipe",
      "input": {
        "method": "v60",
        "title": "X",
        "steps": [
          {
            "atSec": 0,
            "waterG": 40
          }
        ]
      },
      "expected": {
        "ok": false,
        "errors": [
          "steps[0].note must be a non-empty string"
        ]
      }
    },
    {
      "name": "recipe: endSec not after atSec",
      "validator": "CreateRecipe",
      "input": {
        "method": "v60",
        "title": "X",
        "steps": [
          {
            "atSec": 30,
            "endSec": 30,
            "note": "Bloom"
          }
        ]
      },
      "expected": {
        "ok": false,
        "errors": [
          "steps[0].endSec must be greater than atSec"
        ]
      }
    },
    {
      "name": "recipe: zero pour rate",
      "validator": "CreateRecipe",
      "input": {
        "method": "v60",
        "title": "X",
        "steps": [
          {
            "atSec": 0,
            "pourRateGPerSec": 0,
            "note": "Bloom"
          }
        ]
      },
      "expected": {
        "ok": false,
        "errors": [
          "steps[0].pourRateGPerSec must be a positive finite number"
        ]
      }
    },
    {
      "name": "recipe: step water exceeds total",
      "validator": "CreateRecipe",
      "input": {
        "method": "v60",
        "title": "X",
        "params": {
          "waterG": 200
        },
        "steps": [
          {
            "atSec": 0,
            "waterG": 300,
            "note": "Bloom"
          }
        ]
      },
      "expected": {
        "ok": false,
        "errors": [
          "a step waterG (300g) exceeds total params.waterG (200g)"
        ]
      }
    },
    {
      "name": "recipe: cumulative water decreases",
      "validator": "CreateRecipe",
      "input": {
        "method": "v60",
        "title": "X",
        "steps": [
          {
            "atSec": 0,
            "waterG": 140,
            "note": "A"
          },
          {
            "atSec": 40,
            "waterG": 100,
            "note": "B"
          }
        ]
      },
      "expected": {
        "ok": false,
        "errors": [
          "cumulative step waterG decreases (140g → 100g)"
        ]
      }
    },
    {
      "name": "recipe: overlapping steps",
      "validator": "CreateRecipe",
      "input": {
        "method": "v60",
        "title": "X",
        "steps": [
          {
            "atSec": 0,
            "endSec": 50,
            "note": "A"
          },
          {
            "atSec": 45,
            "endSec": 75,
            "note": "B"
          }
        ]
      },
      "expected": {
        "ok": false,
        "errors": [
          "steps overlap: a step starts at 45s before the previous step ends (50s)"
        ]
      }
    },
    {
      "name": "recipe: invalid createdBy",
      "validator": "CreateRecipe",
      "input": {
        "method": "v60",
        "title": "X",
        "createdBy": "robot"
      },
      "expected": {
        "ok": false,
        "errors": [
          "createdBy must be one of agent, manual"
        ]
      }
    },
    {
      "name": "recipe: intent must be strings",
      "validator": "CreateRecipe",
      "input": {
        "method": "v60",
        "title": "X",
        "intent": [
          "ok",
          1
        ]
      },
      "expected": {
        "ok": false,
        "errors": [
          "intent must be a string array"
        ]
      }
    },
    {
      "name": "bean attrs: valid set",
      "validator": "UpdateBeanAttributes",
      "input": {
        "roastLevelOrd": 4,
        "acidity": 2,
        "body": 4,
        "agtronMin": 50,
        "agtronMax": 60,
        "decaf": false,
        "flavorCategories": [
          "nutty_cocoa",
          "sweet"
        ],
        "attrsSource": "manual",
        "sourceUrl": "https://example.com/bean",
        "attrsNotes": "로스터 표기 그대로"
      },
      "expected": {
        "ok": true,
        "value": {
          "roastLevelOrd": 4,
          "acidity": 2,
          "body": 4,
          "agtronMin": 50,
          "agtronMax": 60,
          "decaf": false,
          "flavorCategories": [
            "nutty_cocoa",
            "sweet"
          ],
          "attrsSource": "manual",
          "sourceUrl": "https://example.com/bean",
          "attrsNotes": "로스터 표기 그대로"
        },
        "warnings": []
      }
    },
    {
      "name": "bean attrs: empty object",
      "validator": "UpdateBeanAttributes",
      "input": {},
      "expected": {
        "ok": false,
        "errors": [
          "at least one bean attribute is required"
        ]
      }
    },
    {
      "name": "bean attrs: out of range",
      "validator": "UpdateBeanAttributes",
      "input": {
        "roastLevelOrd": 6,
        "acidity": 0,
        "body": 2.5
      },
      "expected": {
        "ok": false,
        "errors": [
          "roastLevelOrd must be an integer 1-5",
          "acidity must be an integer 1-5",
          "body must be an integer 1-5"
        ]
      }
    },
    {
      "name": "bean attrs: agtron max below min",
      "validator": "UpdateBeanAttributes",
      "input": {
        "agtronMin": 70,
        "agtronMax": 60
      },
      "expected": {
        "ok": false,
        "errors": [
          "agtronMax must be >= agtronMin"
        ]
      }
    },
    {
      "name": "bean attrs: unknown flavor category",
      "validator": "UpdateBeanAttributes",
      "input": {
        "flavorCategories": [
          "fruity",
          "smoky"
        ]
      },
      "expected": {
        "ok": false,
        "errors": [
          "flavorCategories contains unknown values: smoky (allowed: fruity, floral, sweet, nutty_cocoa, spices, roasted, cereal, sour_fermented, green)"
        ]
      }
    },
    {
      "name": "bean attrs: bad source and decaf type",
      "validator": "UpdateBeanAttributes",
      "input": {
        "attrsSource": "guess",
        "decaf": "yes"
      },
      "expected": {
        "ok": false,
        "errors": [
          "decaf must be a boolean",
          "attrsSource must be one of roaster_page, ai_extracted, manual"
        ]
      }
    },
    {
      "name": "purchase link: minimal",
      "validator": "CreateBeanPurchaseLink",
      "input": {
        "vendor": " Kurly ",
        "url": "https://example.com/p/1"
      },
      "expected": {
        "ok": true,
        "value": {
          "vendor": "Kurly",
          "url": "https://example.com/p/1"
        },
        "warnings": []
      }
    },
    {
      "name": "purchase link: full",
      "validator": "CreateBeanPurchaseLink",
      "input": {
        "vendor": "Kurly",
        "url": "https://example.com/p/1",
        "linkCategory": "coupon",
        "priceKrw": 12900,
        "isAffiliate": true,
        "sortOrder": -1
      },
      "expected": {
        "ok": true,
        "value": {
          "vendor": "Kurly",
          "url": "https://example.com/p/1",
          "linkCategory": "coupon",
          "priceKrw": 12900,
          "isAffiliate": true,
          "sortOrder": -1
        },
        "warnings": []
      }
    },
    {
      "name": "purchase link: http url",
      "validator": "CreateBeanPurchaseLink",
      "input": {
        "vendor": "Kurly",
        "url": "http://example.com"
      },
      "expected": {
        "ok": false,
        "errors": [
          "url must start with https://"
        ]
      }
    },
    {
      "name": "purchase link: missing fields",
      "validator": "CreateBeanPurchaseLink",
      "input": {
        "vendor": null
      },
      "expected": {
        "ok": false,
        "errors": [
          "input.vendor must be a string",
          "vendor is required",
          "url is required"
        ]
      }
    },
    {
      "name": "purchase link: bad optional fields",
      "validator": "CreateBeanPurchaseLink",
      "input": {
        "vendor": "V",
        "url": "https://x.example",
        "linkCategory": "ad",
        "priceKrw": -1,
        "isAffiliate": 1,
        "sortOrder": 1.5
      },
      "expected": {
        "ok": false,
        "errors": [
          "linkCategory must be one of product, lowest_price, coupon, generic",
          "priceKrw must be a non-negative integer",
          "isAffiliate must be a boolean",
          "sortOrder must be an integer"
        ]
      }
    },
    {
      "name": "preferences: valid, duplicates removed",
      "validator": "UpdatePreferences",
      "input": {
        "likes": [
          "저산미",
          "고소함",
          "저산미"
        ],
        "dislikes": [
          "고산미"
        ]
      },
      "expected": {
        "ok": true,
        "value": {
          "likes": [
            "저산미",
            "고소함"
          ],
          "dislikes": [
            "고산미"
          ]
        },
        "warnings": []
      }
    },
    {
      "name": "preferences: empty object",
      "validator": "UpdatePreferences",
      "input": {},
      "expected": {
        "ok": true,
        "value": {
          "likes": [],
          "dislikes": []
        },
        "warnings": []
      }
    },
    {
      "name": "preferences: unknown tag",
      "validator": "UpdatePreferences",
      "input": {
        "likes": [
          "저산미",
          "산미 폭발"
        ]
      },
      "expected": {
        "ok": false,
        "errors": [
          "likes contains unknown taste tag(s): 산미 폭발"
        ]
      }
    },
    {
      "name": "preferences: not an array",
      "validator": "UpdatePreferences",
      "input": {
        "likes": "저산미",
        "dislikes": null
      },
      "expected": {
        "ok": false,
        "errors": [
          "likes must be a string array",
          "dislikes must be a string array"
        ]
      }
    },
    {
      "name": "recipe: xBloom structured fields and bypass are preserved",
      "validator": "CreateRecipe",
      "input": {
        "method": "other",
        "title": "xBloom",
        "params": {
          "bypass": {
            "waterG": 50,
            "tempC": 10
          }
        },
        "steps": [
          {
            "atSec": 0,
            "endSec": 10,
            "pauseSec": 2,
            "waterG": 30,
            "note": "Pour",
            "pattern": "center",
            "rpm": 0,
            "vibrationBefore": false,
            "vibrationAfter": true,
            "tempC": 90
          },
          {
            "atSec": 12,
            "endSec": 20,
            "waterG": 50,
            "note": "Pour 2",
            "pattern": "spiral",
            "rpm": 100,
            "pauseSec": 0,
            "tempC": 92
          }
        ]
      },
      "expected": {
        "ok": true,
        "value": {
          "method": "other",
          "title": "xBloom",
          "params": {
            "bypass": {
              "waterG": 50,
              "tempC": 10
            }
          },
          "steps": [
            {
              "note": "Pour",
              "atSec": 0,
              "waterG": 30,
              "endSec": 10,
              "pattern": "center",
              "rpm": 0,
              "vibrationBefore": false,
              "vibrationAfter": true,
              "pauseSec": 2,
              "tempC": 90
            },
            {
              "note": "Pour 2",
              "atSec": 12,
              "waterG": 50,
              "endSec": 20,
              "pattern": "spiral",
              "rpm": 100,
              "pauseSec": 0,
              "tempC": 92
            }
          ]
        },
        "warnings": []
      }
    },
    {
      "name": "recipe: conflicting first-pour temperatures rejected",
      "validator": "CreateRecipe",
      "input": {
        "method": "other",
        "title": "xBloom",
        "params": {
          "tempC": 90
        },
        "steps": [
          {
            "note": "Pour",
            "tempC": 92
          }
        ]
      },
      "expected": {
        "ok": false,
        "errors": [
          "params.tempC must match steps[0].tempC when both are provided"
        ]
      }
    },
    {
      "name": "recipe: xBloom rpm out of range",
      "validator": "CreateRecipe",
      "input": {
        "method": "other",
        "title": "xBloom",
        "steps": [
          {
            "note": "Pour",
            "rpm": 55
          }
        ]
      },
      "expected": {
        "ok": false,
        "errors": [
          "steps[0].rpm must be 0 or a multiple of 10 in 60-120"
        ]
      }
    },
    {
      "name": "recipe: xBloom pauseSec out of range",
      "validator": "CreateRecipe",
      "input": {
        "method": "other",
        "title": "xBloom",
        "steps": [
          {
            "note": "Pour",
            "pauseSec": 256
          }
        ]
      },
      "expected": {
        "ok": false,
        "errors": [
          "steps[0].pauseSec must be an integer in 0-255"
        ]
      }
    },
    {
      "name": "recipe: xBloom tempC out of range",
      "validator": "CreateRecipe",
      "input": {
        "method": "other",
        "title": "xBloom",
        "steps": [
          {
            "note": "Pour",
            "tempC": 96
          }
        ]
      },
      "expected": {
        "ok": false,
        "errors": [
          "steps[0].tempC must be between 40 and 95"
        ]
      }
    },
    {
      "name": "recipe: xBloom pattern out of range",
      "validator": "CreateRecipe",
      "input": {
        "method": "other",
        "title": "xBloom",
        "steps": [
          {
            "note": "Pour",
            "pattern": "zigzag"
          }
        ]
      },
      "expected": {
        "ok": false,
        "errors": [
          "steps[0].pattern must be one of center|spiral|ring"
        ]
      }
    },
    {
      "name": "recipe: xBloom pause contradicts schedule",
      "validator": "CreateRecipe",
      "input": {
        "method": "other",
        "title": "xBloom",
        "steps": [
          {
            "note": "Pour",
            "atSec": 0,
            "endSec": 10,
            "pauseSec": 2
          },
          {
            "note": "Next",
            "atSec": 15
          }
        ]
      },
      "expected": {
        "ok": false,
        "errors": [
          "steps[0].pauseSec must equal steps[1].atSec - steps[0].endSec"
        ]
      }
    },
    {
      "name": "recipe: decimal seconds tolerate floating-point schedule subtraction",
      "validator": "CreateRecipe",
      "input": {
        "method": "other",
        "title": "xBloom",
        "steps": [
          {
            "note": "Pour",
            "atSec": 0,
            "endSec": 0.3,
            "pauseSec": 2
          },
          {
            "note": "Next",
            "atSec": 2.3
          }
        ]
      },
      "expected": {
        "ok": true,
        "value": {
          "method": "other",
          "title": "xBloom",
          "steps": [
            {
              "note": "Pour",
              "atSec": 0,
              "endSec": 0.3,
              "pauseSec": 2
            },
            {
              "note": "Next",
              "atSec": 2.3
            }
          ]
        },
        "warnings": []
      }
    }
  ]
}
