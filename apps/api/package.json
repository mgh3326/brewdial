{
  "name": "@brewdial/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "check": "pnpm --filter @brewdial/shared build && pnpm --filter @brewdial/db build && tsc --noEmit",
    "test": "vitest run",
    "test:http": "bash scripts/test-http.sh"
  },
  "dependencies": {
    "@brewdial/db": "workspace:*",
    "@brewdial/shared": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "@sentry/node": "^8.0.0",
    "hono": "^4.6.0",
    "kysely": "^0.27.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
