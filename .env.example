# BrewDial — App-in-Toss mini-app (React) + MCP server, both on Supabase.

# Supabase — mini-app (client-exposed; Vite needs the VITE_ prefix).
# The publishable key is public and protected by Row Level Security (RLS).
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase service role — MCP server / scripts only.
# SECRET: never use a VITE_/PUBLIC_ prefix and never ship it in the client bundle.
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Sentry — error monitoring. DSNs are public (safe in the client bundle); each
# app points at its own Sentry project so frontend and server errors stay apart.
#  - VITE_SENTRY_DSN: mini-app (React). Vite inlines it at build time.
#  - SENTRY_DSN:      MCP server (Node). Reaches it via the launch wrapper that
#                     sources this .env (services/brewdial-operator/.mcp.json).
# Optional *_ENVIRONMENT overrides the auto-detected environment (defaults to
# build mode / NODE_ENV).
VITE_SENTRY_DSN=
SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=
# SENTRY_ENVIRONMENT=

# (Legacy CouchDB env was removed with apps/web; the one-time migration script
#  reads couch creds from its own env if ever re-run.)
