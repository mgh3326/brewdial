# BrewDial web
PUBLIC_APP_NAME=BrewDial

# Future CouchDB integration
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_DATABASE=coffee
COUCHDB_USERNAME=
COUCHDB_PASSWORD=

# Future agent/MCP API token
BREWDIAL_API_TOKEN=

# Supabase — Apps in Toss WebView SPA (client-exposed; Vite needs the VITE_ prefix).
# The publishable key is public and protected by Row Level Security (RLS).
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase service role — MCP server / scripts only.
# SECRET: never use a VITE_/PUBLIC_ prefix and never ship it in the client bundle.
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
