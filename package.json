{
  "name": "brewdial",
  "private": true,
  "version": "0.1.0",
  "description": "Agent-friendly coffee recipe and feedback dial-in system",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @brewdial/miniapp vite:dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "web:build": "pnpm --filter @brewdial/miniapp web:build",
    "mcp": "pnpm --filter @brewdial/mcp mcp",
    "mcp:dev": "pnpm --filter @brewdial/mcp mcp:dev",
    "mcp:smoke": "pnpm --filter @brewdial/mcp smoke",
    "db:migrate": "pnpm --filter @brewdial/db migrate",
    "db:test": "pnpm --filter @brewdial/db test",
    "db:codegen": "pnpm --filter @brewdial/db codegen",
    "api:dev": "pnpm --filter @brewdial/api dev",
    "api:test": "pnpm --filter @brewdial/api test",
    "api:build": "pnpm --filter @brewdial/api build"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  }
}
