# /etc/brewdial/backup.env  (chmod 600, owned by the backup user `opc`)
# Real values live ONLY on the OCI box, never committed. Copy this to
# /etc/brewdial/backup.env on the box and fill in HC_PING_URL.

# healthchecks.io dead-man's-switch for the daily backup. Get this by creating a
# check named `brewdial-backup` at https://healthchecks.io and copying its ping URL.
# backup.sh pings  <url>/start  on start,  <url>  on success,  <url>/fail  on error.
HC_PING_URL=https://hc-ping.com/REPLACE-WITH-YOUR-UUID

# (optional, separate check `brewdial-verify`) dead-man's-switch for the WEEKLY
# restore-verification. Leave blank to run verify without a ping.
HC_VERIFY_PING_URL=

# Where box-local dumps live (the Mac pulls from here).
BACKUP_DIR=/var/backups/brewdial

# Where to read DATABASE_URL from (same file the API service uses).
API_ENV=/etc/brewdial/api.env

# Retention: keep this many daily dumps + this many weekly (Sunday) dumps.
KEEP_DAILY=7
KEEP_WEEKLY=4
