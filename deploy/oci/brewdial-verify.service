# /etc/systemd/system/brewdial-verify.service
# Weekly restore verification. Triggered by brewdial-verify.timer.
# Install at the PostgreSQL retirement step of docs/runbooks/oci-heatwave-cutover.md;
# until then the host keeps the unit that runs verify-restore.sh against PostgreSQL.
[Unit]
Description=BrewDial restore verification (restore into a throwaway MySQL + checksum compare)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=opc
SupplementaryGroups=docker
ExecStart=/opt/brewdial/deploy/oci/verify-restore-heatwave.sh
Nice=10
IOSchedulingClass=idle
