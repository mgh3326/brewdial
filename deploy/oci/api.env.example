# /etc/brewdial/api.env  (chmod 600, owned by the service user)
# Real secrets live ONLY on the OCI box, never committed. This is keys-only.

# Postgres (local, brewdial_app role over 127.0.0.1 scram-sha-256)
DATABASE_URL=postgres://brewdial_app:CHANGE_ME@127.0.0.1:5432/brewdial

# HTTP port the Cloudflare Tunnel forwards to (server binds 127.0.0.1 by default)
PORT=3020

# Agent/admin surface bearer token (openssl rand -hex 32). Used by the MCP server.
AGENT_TOKEN=CHANGE_ME

# /mcp (Streamable HTTP) behind Cloudflare Access. All three are required: if any
# is unset or blank, /mcp answers 503 and the log says mcp.access disabled.
# Team domain, without scheme (the JWKS and issuer are https://<team-domain>).
BREWDIAL_MCP_CF_TEAM_DOMAIN=<team-domain>.cloudflareaccess.com
# Access application audience tag (Access app → Overview → Application Audience).
BREWDIAL_MCP_CF_AUD=CHANGE_ME_AUD_TAG
# Comma-separated Access user emails allowed to call /mcp.
BREWDIAL_MCP_ALLOWED_EMAILS=CHANGE_ME_OPERATOR_EMAIL

NODE_ENV=production

# Optional
# SENTRY_DSN=
# HOST=127.0.0.1   # default; set 0.0.0.0 only for container/dev
