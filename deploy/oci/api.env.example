# /etc/brewdial/api.env  (chmod 600, owned by the service user)
# Real secrets live ONLY on the OCI box, never committed. This is keys-only.

# Postgres (local, brewdial_app role over 127.0.0.1 scram-sha-256)
DATABASE_URL=postgres://brewdial_app:CHANGE_ME@127.0.0.1:5432/brewdial

# HTTP port the Cloudflare Tunnel forwards to (server binds 127.0.0.1 by default)
PORT=3020

# Agent/admin surface bearer token (openssl rand -hex 32). Used by the MCP server.
AGENT_TOKEN=CHANGE_ME

NODE_ENV=production

# Optional
# SENTRY_DSN=
# HOST=127.0.0.1   # default; set 0.0.0.0 only for container/dev
