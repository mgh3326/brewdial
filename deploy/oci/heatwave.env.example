# /etc/brewdial/heatwave.env  (chmod 600, owned by the backup user `opc`)
# Real values live ONLY on the OCI box, never committed.
#
# A read-only HeatWave user for backup-heatwave.sh and verify-restore-heatwave.sh:
#   create user 'brewdial_backup'@'10.%' identified by '…';
#   grant select, show view, trigger on brewdial.* to 'brewdial_backup'@'10.%';
DATABASE_URL=mysql://brewdial_backup:CHANGE_ME@10.0.0.5:3306/brewdial?sslMode=REQUIRED
