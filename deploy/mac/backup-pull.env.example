# ~/.brewdial-backup.env  (chmod 600) — config for the Mac-side off-box pull.
# Real values live only on the Mac, never committed.

# SSH access to the OCI box (same key used elsewhere).
SSH_KEY=<ssh-key>
BOX=opc@<box-host>
REMOTE_DIR=/var/backups/brewdial/

# Where off-box copies land on the Mac.
LOCAL_DIR=/Users/YOU/brewdial-backups

# (optional, separate healthchecks.io check `brewdial-mac-pull`) dead-man's-switch
# for the daily pull. Leave blank to skip pinging.
HC_PULL_PING_URL=

# Mac-side retention (kept longer than the box's 7+4 for extra safety).
KEEP_DAILY=30
KEEP_WEEKLY=12
KEEP_GLOBALS=30
